#!/usr/bin/env python3
"""opsh — mini-shell en Python (projet Systèmes d'Exploitation, UIR/ESIN).

Fonctionnalités :
  * REPL avec prompt « opsh> », historique et complétion (readline)
  * builtins renommés : go, list, show, path, say, copy, move, del, newdir,
    newfile, info, past, quit + osinfo, export, unset, test, jobs
  * redirections  >  >>  <
  * pipe ->  (à la place de |), arrière-plan &, signaux SIGINT / SIGCHLD
  * variables : $VAR ${VAR} $? $! $$ $1.. ; export ; VAR=valeur
  * substitution $(...) et `...`
  * fichier ~/.opshrc au démarrage
  * mode script : opsh script.opsh  (if / else / fi, for / done, while / done)
"""
import os
import re
import sys
import glob
import time
import shutil
import signal
import stat

try:
    import readline
except ImportError:  # Windows : pas de readline
    readline = None

# --------------------------------------------------------------------------
# État global du shell
# --------------------------------------------------------------------------
shvars = {}          # variables du shell (non exportées)
last_status = 0      # $?
last_bg = ""         # $!
bg_jobs = {}         # pid -> ligne de commande (processus en arrière-plan)
HISTFILE = os.path.expanduser("~/.opsh_history")
ASSIGN = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*=")


# --------------------------------------------------------------------------
# Variables et substitution de commandes
# --------------------------------------------------------------------------
def get_var(name):
    """Valeur d'une variable : spéciales d'abord, puis shell, puis environnement."""
    if name == "?":
        return str(last_status)
    if name == "!":
        return str(last_bg)
    if name == "$":
        return str(os.getpid())
    if name in shvars:
        return shvars[name]
    return os.environ.get(name, "")


def set_var(name, value):
    shvars[name] = value
    if name in os.environ:           # une variable exportée reste synchronisée
        os.environ[name] = value


def capture(cmdline):
    """Exécute cmdline dans un fils (fork) et renvoie sa sortie standard.
    Le fils redirige fd 1 vers un pipe que le père lit : c'est de l'IPC."""
    sys.stdout.flush()
    r, w = os.pipe()
    pid = os.fork()
    if pid == 0:
        os.close(r)
        os.dup2(w, 1)
        os.close(w)
        signal.signal(signal.SIGCHLD, signal.SIG_DFL)
        signal.signal(signal.SIGINT, signal.SIG_DFL)
        try:
            st = execute_line(cmdline)
        except SystemExit as e:
            st = e.code if isinstance(e.code, int) else 0
        sys.stdout.flush()
        os._exit(st & 0xFF)
    os.close(w)
    data = b""
    while True:
        chunk = os.read(r, 4096)
        if not chunk:
            break
        data += chunk
    os.close(r)
    os.waitpid(pid, 0)
    return data.decode(errors="replace").rstrip("\n")


def expand_dollar(s, i):
    """s[i] == '$'. Renvoie (texte_développé, nouvel_index)."""
    n = len(s)
    if i + 1 >= n:
        return "$", i + 1
    c = s[i + 1]
    if c == "(":                                   # $( ... )
        depth, j = 1, i + 2
        while j < n and depth:
            depth += (s[j] == "(") - (s[j] == ")")
            j += 1
        if depth:
            raise SyntaxError("parenthèse non fermée dans $(...)")
        return capture(s[i + 2:j - 1]), j
    if c == "{":                                   # ${VAR}
        j = s.find("}", i + 2)
        if j < 0:
            raise SyntaxError("accolade non fermée dans ${...}")
        return get_var(s[i + 2:j]), j + 1
    if c in "?!$":
        return get_var(c), i + 2
    if c.isdigit():
        return get_var(c), i + 2
    m = re.match(r"[A-Za-z_][A-Za-z0-9_]*", s[i + 1:])
    if m:
        return get_var(m.group()), i + 1 + m.end()
    return "$", i + 1


# --------------------------------------------------------------------------
# Analyse lexicale : ligne -> liste de ("word", texte) / ("op", opérateur)
# --------------------------------------------------------------------------
def tokenize(line):
    toks, cur, has = [], "", False
    i, n = 0, len(line)

    def flush():
        nonlocal cur, has
        if has:
            toks.append(("word", cur))
        cur, has = "", False

    while i < n:
        c = line[i]
        if c in " \t":
            flush(); i += 1
        elif c == "#" and not has:                  # commentaire
            break
        elif line.startswith("->", i):              # notre pipe
            flush(); toks.append(("op", "->")); i += 2
        elif line.startswith(">>", i):
            flush(); toks.append(("op", ">>")); i += 2
        elif c in "<>&":
            flush(); toks.append(("op", c)); i += 1
        elif c == "'":                              # quotes simples : littéral
            j = line.find("'", i + 1)
            if j < 0:
                raise SyntaxError("quote ' non fermée")
            cur += line[i + 1:j]; has = True; i = j + 1
        elif c == '"':                              # doubles : expansions permises
            i += 1; has = True
            while i < n and line[i] != '"':
                if line[i] == "$":
                    t, i = expand_dollar(line, i); cur += t
                elif line[i] == "`":
                    j = line.find("`", i + 1)
                    if j < 0:
                        raise SyntaxError("backtick non fermé")
                    cur += capture(line[i + 1:j]); i = j + 1
                elif line[i] == "\\" and i + 1 < n:
                    cur += line[i + 1]; i += 2
                else:
                    cur += line[i]; i += 1
            if i >= n:
                raise SyntaxError('quote " non fermée')
            i += 1
        elif c == "$":
            t, i = expand_dollar(line, i); cur += t; has = True
        elif c == "`":
            j = line.find("`", i + 1)
            if j < 0:
                raise SyntaxError("backtick non fermé")
            cur += capture(line[i + 1:j]); has = True; i = j + 1
        elif c == "\\" and i + 1 < n:
            cur += line[i + 1]; has = True; i += 2
        else:
            cur += c; has = True; i += 1
    flush()
    return toks


def parse(toks):
    """Découpe par '->' ; extrait redirections et '&'.
    Renvoie ([(argv, redirs), ...], background)."""
    bg = False
    if toks and toks[-1] == ("op", "&"):
        bg, toks = True, toks[:-1]
    segs = [[]]
    for t in toks:
        if t == ("op", "->"):
            segs.append([])
        else:
            segs[-1].append(t)
    cmds = []
    for seg in segs:
        argv, redirs, j = [], [], 0
        while j < len(seg):
            kind, val = seg[j]
            if kind == "op" and val in ("<", ">", ">>"):
                if j + 1 >= len(seg) or seg[j + 1][0] != "word":
                    raise SyntaxError(f"fichier attendu après {val}")
                redirs.append((val, seg[j + 1][1])); j += 2
            elif kind == "op":
                raise SyntaxError(f"opérateur inattendu « {val} »")
            else:
                argv.append(val); j += 1
        if not argv:
            raise SyntaxError("commande vide autour de ->")
        cmds.append((argv, redirs))
    return cmds, bg


# --------------------------------------------------------------------------
# Builtins (chacun renvoie un code de retour)
# --------------------------------------------------------------------------
def err(msg):
    print(f"opsh: {msg}", file=sys.stderr)
    return 1


def b_go(a):
    """cd : DOIT être un builtin. chdir() modifie le répertoire courant du
    processus appelant ; dans un fils forké, le shell parent ne verrait rien."""
    target = a[1] if len(a) > 1 else os.environ.get("HOME", "/")
    if target == "-":
        target = os.environ.get("OLDPWD", os.getcwd())
    old = os.getcwd()
    try:
        os.chdir(target)
    except OSError as e:
        return err(f"go: {target}: {e.strerror}")
    os.environ["OLDPWD"] = old
    os.environ["PWD"] = os.getcwd()
    return 0


def b_quit(a):
    code = int(a[1]) if len(a) > 1 and a[1].lstrip("-").isdigit() else last_status
    raise SystemExit(code)


def b_path(a):
    print(os.getcwd()); return 0


def b_say(a):
    args, nl = a[1:], True
    if args and args[0] == "-n":
        args, nl = args[1:], False
    sys.stdout.write(" ".join(args) + ("\n" if nl else ""))
    return 0


def b_list(a):
    show_all = long_fmt = False
    paths = []
    for x in a[1:]:
        if x.startswith("-") and len(x) > 1:
            show_all |= "a" in x
            long_fmt |= "l" in x
        else:
            paths.append(x)
    paths = paths or ["."]
    status = 0
    for p in paths:
        if len(paths) > 1:
            print(f"{p}:")
        try:
            names = sorted(os.listdir(p)) if os.path.isdir(p) else [p]
        except OSError as e:
            status = err(f"list: {p}: {e.strerror}"); continue
        if show_all:
            names = [".", ".."] + names
        else:
            names = [x for x in names if not x.startswith(".")]
        if long_fmt:
            for nm in names:
                full = nm if p == nm else os.path.join(p, nm)
                st = os.lstat(full)
                date = time.strftime("%d %b %H:%M", time.localtime(st.st_mtime))
                print(f"{stat.filemode(st.st_mode)} {st.st_size:>8} {date} {nm}")
        else:
            print("  ".join(names))
    return status


def b_show(a):
    """cat : sans argument, lit l'entrée standard (utile dans un pipe ->)."""
    if len(a) == 1:
        sys.stdout.write(sys.stdin.read()); return 0
    status = 0
    for f in a[1:]:
        try:
            with open(f, "r", errors="replace") as fh:
                shutil.copyfileobj(fh, sys.stdout)
        except OSError as e:
            status = err(f"show: {f}: {e.strerror}")
    return status


def b_copy(a):
    args = [x for x in a[1:] if not x.startswith("-")]
    rec = any(x.startswith("-") and "r" in x.lower() for x in a[1:])
    if len(args) < 2:
        return err("copy: usage: copy [-r] source... destination")
    dst, status = args[-1], 0
    for src in args[:-1]:
        try:
            if os.path.isdir(src):
                if not rec:
                    status = err(f"copy: {src} est un dossier (utiliser -r)"); continue
                target = os.path.join(dst, os.path.basename(src.rstrip("/"))) \
                    if os.path.isdir(dst) else dst
                shutil.copytree(src, target)
            else:
                shutil.copy(src, dst)
        except OSError as e:
            status = err(f"copy: {src}: {e.strerror or e}")
    return status


def b_move(a):
    args = [x for x in a[1:] if not x.startswith("-")]
    if len(args) < 2:
        return err("move: usage: move source... destination")
    status = 0
    for src in args[:-1]:
        try:
            shutil.move(src, args[-1])
        except (OSError, shutil.Error) as e:
            status = err(f"move: {src}: {e}")
    return status


def b_del(a):
    flags = "".join(x for x in a[1:] if x.startswith("-"))
    files = [x for x in a[1:] if not x.startswith("-")]
    if not files:
        return err("del: usage: del [-r] [-f] fichier...")
    status = 0
    for f in files:
        try:
            if os.path.isdir(f) and not os.path.islink(f):
                if "r" not in flags.lower():
                    status = err(f"del: {f} est un dossier (utiliser -r)"); continue
                shutil.rmtree(f)
            else:
                os.remove(f)
        except OSError as e:
            if "f" not in flags:
                status = err(f"del: {f}: {e.strerror}")
    return status


def b_newdir(a):
    parents = "-p" in a
    dirs = [x for x in a[1:] if x != "-p"]
    if not dirs:
        return err("newdir: usage: newdir [-p] dossier...")
    status = 0
    for d in dirs:
        try:
            os.makedirs(d, exist_ok=parents) if parents else os.mkdir(d)
        except OSError as e:
            status = err(f"newdir: {d}: {e.strerror}")
    return status


def b_newfile(a):
    if len(a) < 2:
        return err("newfile: usage: newfile fichier...")
    status = 0
    for f in a[1:]:
        try:
            with open(f, "a"):
                os.utime(f, None)
        except OSError as e:
            status = err(f"newfile: {f}: {e.strerror}")
    return status


def b_past(a):
    if readline:
        for i in range(1, readline.get_current_history_length() + 1):
            print(f"{i:4}  {readline.get_history_item(i)}")
    return 0


def b_osinfo(a):
    print("Systèmes d’Exploitation –- UIR/ESIN"); return 0


def b_export(a):
    for arg in a[1:]:
        name, eq, val = arg.partition("=")
        if eq:
            shvars[name] = val
        os.environ[name] = shvars.get(name, os.environ.get(name, ""))
    return 0


def b_unset(a):
    for name in a[1:]:
        shvars.pop(name, None); os.environ.pop(name, None)
    return 0


def b_jobs(a):
    for pid, cmd in bg_jobs.items():
        print(f"[{pid}] En cours  {cmd}")
    return 0


def b_test(a):
    """test EXPR : -f -d -e -z -n, =, !=, -eq -ne -lt -le -gt -ge, négation !"""
    args = a[1:]
    if args and args[-1] == "]":
        args = args[:-1]
    neg = bool(args and args[0] == "!")
    if neg:
        args = args[1:]
    try:
        if len(args) == 1:
            r = args[0] != ""
        elif len(args) == 2:
            op, x = args
            r = {"-f": os.path.isfile, "-d": os.path.isdir, "-e": os.path.exists,
                 "-z": lambda s: s == "", "-n": lambda s: s != ""}[op](x)
        elif len(args) == 3:
            x, op, y = args
            if op == "=":
                r = x == y
            elif op == "!=":
                r = x != y
            else:
                x, y = int(x), int(y)
                r = {"-eq": x == y, "-ne": x != y, "-lt": x < y,
                     "-le": x <= y, "-gt": x > y, "-ge": x >= y}[op]
        else:
            return 2
    except (KeyError, ValueError):
        return 2
    return 0 if r != neg else 1


HELP = """opsh — builtins disponibles :
  go [dir]        (cd)     changer de répertoire
  list [-a] [-l]  (ls)     lister un répertoire
  show [fichier]  (cat)    afficher un fichier (ou stdin)
  path            (pwd)    répertoire courant
  say [-n] txt    (echo)   afficher du texte
  copy [-r] s d   (cp)     copier        move s d  (mv)  déplacer
  del [-r] f      (rm)     supprimer     newdir d  (mkdir)  newfile f (touch)
