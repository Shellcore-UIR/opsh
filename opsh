def path_executables():
    out = set()
    for d in os.environ.get("PATH", "").split(os.pathsep):
        try:
            for f in os.listdir(d):
                if os.access(os.path.join(d, f), os.X_OK):
                    out.add(f)
        except OSError:
            pass
    return out


_exe_cache = None


def completer(text, state):
    global _exe_cache
    buf = readline.get_line_buffer()[:readline.get_begidx()].rstrip()
    matches = []
    if buf == "" or buf.endswith("->"):
        if _exe_cache is None:
            _exe_cache = path_executables()
        matches += [c for c in sorted(set(BUILTINS) | _exe_cache) if c.startswith(text)]
    for f in sorted(glob.glob(os.path.expanduser(text) + "*")):
        matches.append(f + "/" if os.path.isdir(f) else f)
    return matches[state] if state < len(matches) else None


def setup_readline():
    if not readline:
        return
    try:
        readline.read_history_file(HISTFILE)
    except OSError:
        pass
    readline.set_completer_delims(" \t\n")
    readline.set_completer(completer)
    if "libedit" in (readline.__doc__ or ""):
        readline.parse_and_bind("bind ^I rl_complete")
    else:
        readline.parse_and_bind("tab: complete")


def load_rc():
    rc = os.path.expanduser("~/.opshrc")
    if os.path.isfile(rc):
        with open(rc) as fh:
            for l in fh:
                if l.strip() and not l.lstrip().startswith("#"):
                    execute_line(l.rstrip("\n"))


def repl():
    setup_readline()
    load_rc()
    try:
        while True:
            try:
                line = input("opsh> ")
            except EOFError:
                print(); break
            except KeyboardInterrupt:
                print(); continue
            if line.strip():
                execute_line(line)
    except SystemExit:
        pass
    finally:
        if readline:
            try:
                readline.write_history_file(HISTFILE)
            except OSError:
                pass


def main():
    signal.signal(signal.SIGCHLD, on_sigchld)
    if len(sys.argv) > 1:
        sys.exit(run_script(sys.argv[1], sys.argv[2:]))
    repl()
    sys.exit(last_status)


if __name__ == "__main__":
    main()
