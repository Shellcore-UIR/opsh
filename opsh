  quit [code]     (exit)   quitter       osinfo       infos du cours
  export N=V / unset N / test EXPR / jobs
Syntaxe : cmd1 -> cmd2 (pipe), > >> < (redirections), & (arrière-plan),
          $VAR ${VAR} $? $! $(cmd) `cmd`, VAR=valeur"""


def b_info(a):
    print(HELP); return 0


BUILTINS = {
    "go": b_go, "quit": b_quit, "path": b_path, "say": b_say, "list": b_list,
    "show": b_show, "copy": b_copy, "move": b_move, "del": b_del,
    "newdir": b_newdir, "newfile": b_newfile, "past": b_past, "info": b_info,
    "osinfo": b_osinfo, "export": b_export, "unset": b_unset, "jobs": b_jobs,
    "test": b_test, "[": b_test,
}


def run_builtin(argv):
    try:
        return BUILTINS[argv[0]](argv) or 0
    except BrokenPipeError:
        return 0
    except OSError as e:
        return err(f"{argv[0]}: {e.strerror or e}")


# --------------------------------------------------------------------------
# Exécution : fork / dup2 / exec / wait
# --------------------------------------------------------------------------
def apply_redirs(redirs):
    """Redirige les descripteurs 0 et 1 avec dup2 (fd 0=stdin, 1=stdout)."""
    for op, fname in redirs:
        if op == "<":
            fd, target = os.open(fname, os.O_RDONLY), 0
        else:
            flags = os.O_WRONLY | os.O_CREAT | (os.O_APPEND if op == ">>" else os.O_TRUNC)
            fd, target = os.open(fname, flags, 0o644), 1
        os.dup2(fd, target)
        os.close(fd)


def child_main(argv, redirs):
    """Code du processus fils : ne retourne jamais."""
    signal.signal(signal.SIGINT, signal.SIG_DFL)   # le fils doit être interruptible
    signal.signal(signal.SIGCHLD, signal.SIG_DFL)
    try:
        apply_redirs(redirs)
        if argv[0] in BUILTINS:
            try:
                st = run_builtin(argv)
            except SystemExit as e:
                st = e.code if isinstance(e.code, int) else 0
            sys.stdout.flush()
            os._exit(st & 0xFF)
        os.execvp(argv[0], argv)                    # remplace l'image du processus
    except FileNotFoundError as e:
        name = e.filename or argv[0]
        print(f"opsh: {argv[0]}: commande introuvable" if name == argv[0]
              else f"opsh: {name}: fichier introuvable", file=sys.stderr)
        os._exit(127)
    except OSError as e:
        print(f"opsh: {argv[0]}: {e.strerror}", file=sys.stderr)
        os._exit(126)


def run_builtin_inprocess(argv, redirs):
    """Builtin seul, sans pipe : exécuté dans le shell lui-même (go/export...)."""
    saved = [os.dup(i) for i in (0, 1, 2)]
    try:
        apply_redirs(redirs)
        return run_builtin(argv)
    except OSError as e:
        return err(f"{e.filename}: {e.strerror}")
    finally:
        sys.stdout.flush()
        for i, s in enumerate(saved):
            os.dup2(s, i); os.close(s)


def status_of(st):
    if os.WIFSIGNALED(st):
        return 128 + os.WTERMSIG(st)
    return os.WEXITSTATUS(st)


def execute(cmds, bg, line):
    if len(cmds) == 1 and not bg and cmds[0][0][0] in BUILTINS:
        return run_builtin_inprocess(*cmds[0])

    sys.stdout.flush()
    old_int = signal.signal(signal.SIGINT, signal.SIG_IGN)  # Ctrl-C ne tue pas le shell
    pids, prev, pgid = [], None, 0
    try:
        for idx, (argv, redirs) in enumerate(cmds):
            r = w = None
            if idx < len(cmds) - 1:
                r, w = os.pipe()
            pid = os.fork()
            if pid == 0:
                if bg:
                    os.setpgid(0, pgid)              # groupe séparé : pas de SIGINT clavier
                if prev is not None:
                    os.dup2(prev, 0); os.close(prev)
                if w is not None:
                    os.dup2(w, 1); os.close(w); os.close(r)
                child_main(argv, redirs)
            if bg:
                pgid = pgid or pid
                try:
                    os.setpgid(pid, pgid)
                except OSError:
                    pass
            if prev is not None:
                os.close(prev)                       # le père ferme ses copies des pipes
            if w is not None:
                os.close(w)
            prev = r
            pids.append(pid)
    finally:
        if bg:
            signal.signal(signal.SIGINT, old_int)

    global last_bg
    if bg:
        last_bg = str(pids[-1])
        for p in pids:
            bg_jobs[p] = line
        print(f"[{pids[-1]}] lancé en arrière-plan")
        return 0

    status = 0
    try:
        for p in pids:
            _, st = os.waitpid(p, 0)
            status = status_of(st)
            if os.WIFSIGNALED(st) and os.WTERMSIG(st) == signal.SIGINT:
                print()
    finally:
        signal.signal(signal.SIGINT, old_int)
    return status


def execute_line(line):
    """Exécute une ligne ; met à jour et renvoie $?."""
    global last_status
    try:
        toks = tokenize(line)
        if not toks:
            return last_status
        if len(toks) == 1 and toks[0][0] == "word" and ASSIGN.match(toks[0][1]):
            name, _, val = toks[0][1].partition("=")
            set_var(name, val)
            last_status = 0
            return 0
        cmds, bg = parse(toks)
        last_status = execute(cmds, bg, line)
    except SyntaxError as e:
        print(f"opsh: erreur de syntaxe : {e}", file=sys.stderr)
        last_status = 2
    except OSError as e:
        print(f"opsh: {e}", file=sys.stderr)
        last_status = 1
    return last_status


# --------------------------------------------------------------------------
# Signaux : SIGCHLD récolte les processus d'arrière-plan (évite les zombies)
# --------------------------------------------------------------------------
def on_sigchld(signum, frame):
    for pid in list(bg_jobs):
        try:
            p, st = os.waitpid(pid, os.WNOHANG)
        except ChildProcessError:
            bg_jobs.pop(pid, None)
            continue
        if p:
            cmd = bg_jobs.pop(pid)
            print(f"\n[{pid}] terminé (statut {status_of(st)})  {cmd}")


# --------------------------------------------------------------------------
# Mode script : if / for / while
# --------------------------------------------------------------------------
def _clean(line, kw):
    rest = line[len(kw):].strip()
    for suf in ("; then", "; do"):
        if rest.endswith(suf):
            rest = rest[:-len(suf)].strip()
    return rest


def parse_block(lines, i, terms):
    nodes = []
    while i < len(lines):
        l = lines[i].strip()
        if not l or l.startswith("#"):
            i += 1; continue
        w = l.split()[0]
        if w in terms:
            return nodes, i, w
        if w in ("then", "do"):
            i += 1; continue
        if w in ("fi", "done", "else"):
            raise SyntaxError(f"« {w} » inattendu")
        if w == "if":
            cond = _clean(l, "if")
            body, i, t = parse_block(lines, i + 1, ("else", "fi"))
            orelse = []
            if t == "else":
                orelse, i, t = parse_block(lines, i + 1, ("fi",))
            nodes.append(("if", cond, body, orelse)); i += 1
        elif w == "for":
            m = re.match(r"for\s+(\w+)\s+in\s*(.*?)(;\s*do)?$", l)
            if not m:
                raise SyntaxError("for: syntaxe « for VAR in a b c »")
            body, i, _ = parse_block(lines, i + 1, ("done",))
            nodes.append(("for", m.group(1), m.group(2), body)); i += 1
        elif w == "while":
            cond = _clean(l, "while")
            body, i, _ = parse_block(lines, i + 1, ("done",))
            nodes.append(("while", cond, body)); i += 1
        else:
            nodes.append(("cmd", l)); i += 1
    if terms:
        raise SyntaxError(f"bloc non fermé (« {terms[-1]} » attendu)")
    return nodes, i, None


def exec_nodes(nodes):
    for n in nodes:
        if n[0] == "cmd":
            execute_line(n[1])
        elif n[0] == "if":
            exec_nodes(n[2] if execute_line(n[1]) == 0 else n[3])
        elif n[0] == "while":
            while execute_line(n[1]) == 0:
                exec_nodes(n[2])
        elif n[0] == "for":
            items = [v for k, v in tokenize(n[2]) if k == "word"]
            for it in items:
                set_var(n[1], it)
                exec_nodes(n[3])


def run_lines(lines):
    nodes, _, _ = parse_block(lines, 0, ())
    exec_nodes(nodes)


def run_script(path, args):
    shvars["0"] = path
    for k, v in enumerate(args, 1):
        shvars[str(k)] = v
    try:
        with open(path) as fh:
            run_lines(fh.read().splitlines())
    except OSError as e:
        return err(f"{path}: {e.strerror}")
    except SyntaxError as e:
        print(f"opsh: {path}: erreur de syntaxe : {e}", file=sys.stderr)
        return 2
    return last_status


